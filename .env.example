# ========================================
# Parenta — environment template
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# ========================================

# ----------------------------------------
# DATABASE (required)
# ----------------------------------------
# Database password (Supabase Dashboard → Project Settings → Database)
DB_PASSWORD="your-database-password"

# App runtime: Supabase transaction-mode pooler (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI / migrations: Supabase session-mode pooler (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ----------------------------------------
# AUTHENTICATION (required)
# ----------------------------------------
NEXTAUTH_URL="http://localhost:3030"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ----------------------------------------
# ENVIRONMENT (required)
# ----------------------------------------
NODE_ENV="development"
PORT=3030

# ----------------------------------------
# LOCAL SEED / INIT LOCK (development only)
# ----------------------------------------
# Required to call POST /api/seed-users, /api/seed-db, /api/init-db, /api/seed-tenant
# Send as header: x-seed-secret: <this value>
# Leave unset (or omit) in production — those routes return 403.
SEED_SECRET="replace-with-a-local-only-seed-secret"

# ----------------------------------------
# EMAIL NOTIFICATIONS (optional — Gmail)
# ----------------------------------------
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"
# EMAIL_FROM="Alfonso Property Management System <your-email@gmail.com>"

# ----------------------------------------
# BRAND / LANDLORD (lease agreements)
# ----------------------------------------
# Shown as {{landlord.companyName}} on generated leases
# NEXT_PUBLIC_LANDLORD_COMPANY_NAME="Alfonso Property Management System"

# ----------------------------------------
# FILE STORAGE (required on Vercel; optional locally)
# ----------------------------------------
# From Vercel Dashboard → Storage → Blob → .env.local
# Or: vercel env pull .env.local
# Without this locally, image/document uploads fall back to public/uploads/
BLOB_READ_WRITE_TOKEN=""
