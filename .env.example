# ========================================
# Parenta — environment template
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# ========================================

# ----------------------------------------
# DATABASE (required)
# ----------------------------------------
# App runtime (transaction / pooler URL is fine for Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Direct/session URL for Prisma CLI / migrations (local: same as DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ----------------------------------------
# AUTHENTICATION (required)
# ----------------------------------------
NEXTAUTH_URL="http://localhost:3030"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ----------------------------------------
# ENVIRONMENT (required)
# ----------------------------------------
NODE_ENV="development"
PORT=3030

# ----------------------------------------
# LOCAL SEED / INIT LOCK (development only)
# ----------------------------------------
# Required to call POST /api/seed-users, /api/seed-db, /api/init-db, /api/seed-tenant
# Send as header: x-seed-secret: <this value>
# Leave unset (or omit) in production — those routes return 403.
SEED_SECRET="replace-with-a-local-only-seed-secret"

# ----------------------------------------
# EMAIL NOTIFICATIONS (optional — Gmail)
# ----------------------------------------
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-app-password"
# EMAIL_FROM="Parenta <your-email@gmail.com>"

# ----------------------------------------
# FILE STORAGE (optional — Vercel Blob)
# ----------------------------------------
# BLOB_READ_WRITE_TOKEN=""
