  documents          documents[]

  @@index([board_id, stage_id, position], map: "idx_pipeline_cards_board_stage")
  @@index([card_status], map: "idx_pipeline_cards_status")
  @@index([building_id], map: "idx_pipeline_cards_building")
  @@index([tenant_id], map: "idx_pipeline_cards_tenant")
