  lost_at            DateTime?                @db.Timestamptz(6)
  created_by         String?                  @db.Uuid
  created_at         DateTime?                @default(now()) @db.Timestamp(6)
  updated_at         DateTime?                @default(now()) @db.Timestamp(6)
  board              pipeline_boards          @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stage              pipeline_stages          @relation(fields: [stage_id], references: [id], onUpdate: NoAction)
  prior_stage        pipeline_stages?         @relation("CardPriorStage", fields: [prior_stage_id], references: [id], onUpdate: NoAction)
  prior_board        pipeline_boards?         @relation("CardPriorBoard", fields: [prior_board_id], references: [id], onUpdate: NoAction)
