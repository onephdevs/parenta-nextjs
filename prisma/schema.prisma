/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset_assignments {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                String          @db.Uuid
  room_id                 String?         @db.Uuid
  tenant_id               String?         @db.Uuid
  assignment_date         DateTime        @db.Date
  return_date             DateTime?       @db.Date
  monthly_rental_fee      Decimal?        @db.Decimal(10, 2)
  assignment_status       String?         @default("active") @db.VarChar(20)
  condition_on_assignment String?         @db.VarChar(50)
  condition_on_return     String?         @db.VarChar(50)
  notes                   String?
  created_at              DateTime?       @default(now()) @db.Timestamp(6)
  updated_at              DateTime?       @default(now()) @db.Timestamp(6)
  assets                  assets          @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms                   rooms?          @relation(fields: [room_id], references: [id], onUpdate: NoAction)
  tenants                 tenants?        @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
  asset_billing           asset_billing[]

  @@index([asset_id], map: "idx_asset_assignments_asset")
  @@index([room_id], map: "idx_asset_assignments_room")
  @@index([assignment_status], map: "idx_asset_assignments_status")
  @@index([tenant_id], map: "idx_asset_assignments_tenant")
}

