  from_stage    pipeline_stages? @relation("EventFromStage", fields: [from_stage_id], references: [id], onUpdate: NoAction)
  to_stage      pipeline_stages? @relation("EventToStage", fields: [to_stage_id], references: [id], onUpdate: NoAction)
  from_board    pipeline_boards? @relation("EventFromBoard", fields: [from_board_id], references: [id], onUpdate: NoAction)
  to_board      pipeline_boards? @relation("EventToBoard", fields: [to_board_id], references: [id], onUpdate: NoAction)
  creator       users?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)

